<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BK ACADEMY - Official Home</title>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* --- GLOBAL RESET & VARS --- */
        :root {
            --primary-color: #0f172a;    /* Dark Navy */
            --accent-color: #3b82f6;     /* Bright Blue */
            --highlight-color: #f59e0b;  /* Amber Gold */
            --text-dark: #1e293b;
            --text-gray: #64748b;
            --white: #ffffff;
            --bg-light: #f1f5f9;
            --shadow: 0 10px 40px -10px rgba(0,0,0,0.1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Hind Siliguri', sans-serif; }
        
        body {
            background-color: var(--white);
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a { text-decoration: none; transition: 0.3s; }
        ul { list-style: none; }

        /* --- LAYOUT UTILITIES --- */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .section-padding { padding: 80px 0; }
        
        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }
        .section-header h2 {
            font-size: 32px;
            font-weight: 700;
            color: var(--primary-color);
            position: relative;
            display: inline-block;
        }
        .section-header h2::after {
            content: '';
            display: block;
            width: 60px;
            height: 4px;
            background: var(--highlight-color);
            margin: 8px auto 0;
            border-radius: 2px;
        }
        .section-header p { color: var(--text-gray); margin-top: 10px; }

        /* --- BUTTONS --- */
        .btn {
            display: inline-block;
            padding: 12px 30px;
            background: var(--accent-color);
            color: var(--white);
            border-radius: 50px;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
            border: none;
            cursor: pointer;
        }
        .btn:hover { background: #2563eb; transform: translateY(-2px); }
        .btn-outline {
            background: transparent;
            border: 2px solid var(--white);
            color: var(--white);
            box-shadow: none;
        }
        .btn-outline:hover { background: var(--white); color: var(--primary-color); }

        /* --- HEADER & NAV --- */
        header {
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        }
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 70px;
        }
        .logo {
            font-size: 24px;
            font-weight: 800;
            color: var(--primary-color);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .logo i { color: var(--highlight-color); }
        
        .menu { display: flex; gap: 30px; }
        .menu a { color: var(--text-dark); font-weight: 600; font-size: 15px; }
        .menu a:hover { color: var(--accent-color); }
        
        .login-trigger {
            background: var(--primary-color);
            color: white !important;
            padding: 8px 20px;
            border-radius: 6px;
        }

        /* --- HERO SECTION --- */
        .hero {
            background: linear-gradient(rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.85)), url('https://images.unsplash.com/photo-1523050854058-8df90110c9f1?ixlib=rb-1.2.1&auto=format&fit=crop&w=1600&q=80');
            background-size: cover;
            background-position: center;
            height: 500px;
            display: flex;
            align-items: center;
            text-align: center;
            color: var(--white);
        }
        .hero h1 { font-size: 42px; font-weight: 800; line-height: 1.2; margin-bottom: 20px; }
        .hero p { font-size: 18px; max-width: 700px; margin: 0 auto 30px; opacity: 0.9; }

        /* --- STATS --- */
        .stats-container {
            margin-top: -50px;
            position: relative;
            z-index: 10;
        }
        .stats-box {
            background: var(--white);
            border-radius: 15px;
            box-shadow: var(--shadow);
            padding: 30px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            text-align: center;
        }
        .stat h3 { font-size: 32px; font-weight: 800; color: var(--accent-color); margin-bottom: 5px; }
        .stat p { font-size: 14px; font-weight: 600; color: var(--text-gray); text-transform: uppercase; }

        /* --- COURSES --- */
        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }
        .course-card {
            background: var(--white);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            transition: 0.3s;
        }
        .course-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); border-color: var(--accent-color); }
        
        .c-header {
            background: var(--bg-light);
            padding: 20px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .badge { background: var(--accent-color); color: white; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: bold; }
        
        .c-body { padding: 25px; }
        .c-body h3 { font-size: 20px; margin-bottom: 15px; }
        .c-meta { display: flex; gap: 15px; font-size: 14px; color: var(--text-gray); margin-bottom: 20px; }
        .c-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 15px; border-top: 1px dashed #e2e8f0; }
        .price { font-size: 18px; font-weight: 800; color: var(--primary-color); }

        /* --- TEACHERS --- */
        .bg-light { background-color: var(--bg-light); }
        .teacher-card {
            background: var(--white);
            padding: 30px 20px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            transition: 0.3s;
        }
        .teacher-card:hover { transform: scale(1.03); }
        .t-img {
            width: 120px; height: 120px;
            background: #cbd5e1;
            border-radius: 50%;
            margin: 0 auto 15px;
            object-fit: cover;
            border: 4px solid #e2e8f0;
        }
        .t-role { color: var(--accent-color); font-size: 13px; font-weight: 700; text-transform: uppercase; margin-bottom: 5px; display: block; }
        .t-social { margin-top: 15px; }
        .t-social a { color: var(--text-gray); margin: 0 5px; font-size: 18px; }
        .t-social a:hover { color: var(--accent-color); }

        /* --- NOTICE & CONTACT LAYOUT --- */
        .split-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }
        .box-style {
            background: var(--white);
            padding: 30px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            height: 100%;
        }
        .notice-item {
            display: flex;
            gap: 15px;
            padding-bottom: 15px;
            margin-bottom: 15px;
            border-bottom: 1px solid #f1f5f9;
        }
        .n-date {
            background: var(--bg-light);
            padding: 8px 12px;
            border-radius: 8px;
            text-align: center;
            min-width: 60px;
        }
        .n-date b { display: block; font-size: 18px; color: var(--primary-color); line-height: 1; }
        .n-date span { font-size: 12px; color: var(--text-gray); }
        .n-content h4 { font-size: 16px; margin-bottom: 5px; }
        .n-content p { font-size: 13px; color: var(--text-gray); }

        /* --- FORM --- */
        .form-group { margin-bottom: 15px; }
        .form-control {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 14px;
        }
        .form-control:focus { outline: 2px solid var(--accent-color); border-color: transparent; }

        /* --- FOOTER --- */
        footer {
            background: var(--primary-color);
            color: #94a3b8;
            padding: 60px 0 20px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }
        .f-logo { color: var(--white); font-size: 20px; font-weight: 800; margin-bottom: 15px; display: block; }
        .f-header { color: var(--white); font-size: 16px; font-weight: 700; margin-bottom: 20px; }
        .f-links li { margin-bottom: 10px; }
        .f-links a { color: #94a3b8; font-size: 14px; }
        .f-links a:hover { color: var(--highlight-color); padding-left: 5px; }
        .copyright { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; text-align: center; font-size: 13px; }

        /* --- MODAL --- */
        .modal {
            display: none;
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(5px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }
        .modal-box {
            background: white;
            padding: 40px;
            width: 90%; max-width: 400px;
            border-radius: 12px;
            position: relative;
            animation: slideIn 0.3s ease;
        }
        .close-btn { position: absolute; top: 15px; right: 20px; font-size: 24px; cursor: pointer; color: #94a3b8; }
        @keyframes slideIn { from {transform: translateY(-20px); opacity: 0;} to {transform: translateY(0); opacity: 1;} }

        /* --- RESPONSIVE --- */
        @media (max-width: 768px) {
            .menu { display: none; } /* Mobile menu handling needed or keep simple */
            .stats-box { grid-template-columns: 1fr 1fr; gap: 20px; }
            .split-section, .footer-grid { grid-template-columns: 1fr; }
            .hero h1 { font-size: 32px; }
        }
    </style>
</head>
